$macro SRCDIR		".."

$include "$SRCDIR\vpc_scripts\source_lib_base.vpc"

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions		"$BASE;STUTIL_STATIC_LIB"
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\thirdparty\json\include"
	}
}

$Project "stutil"
{
	$Folder	"Source Files"
	{
		$File	"json.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"$SRCDIR\public\stutil\json.h"
	}

	$Folder "Link Libraries"
	{
	    $Lib    "tier1"
	}
}
